# This is a sample RESC script.
# Please change this file and test.robot to include all necessary steps to reproduce your issue.
# Make this repository as self contained as possible.
#

$name?="TestMachine"
$repl?=@https://zephyr-dashboard.renode.io/zephyr_sim/df8b43d330edadad7113e57e540c647b7464ea45/d82be128f20e28a4954fe2bd70f980fdffe32609/nucleo_h563zi/hello_world/hello_world.repl
$bin?=@artifacts/fft_benchmark.elf

using sysbus
mach create $name
machine LoadPlatformDescription $repl 

showAnalyzer sysbus.usart3

macro reset
"""
    sysbus LoadELF $bin
"""
runMacro $reset
